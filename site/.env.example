# Copy to .env.local for local development. Never commit real values.
# In production these are set in Cloudflare Pages → Settings → Environment variables.

# Contact form endpoint (Web3Forms or Formspree). Empty = the form says it isn't connected yet.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Public site URL, used for metadata and Open Graph (Phase 3), e.g. https://linaliandrea.com
NEXT_PUBLIC_SITE_URL=

# Optional: serve images from another origin (e.g. Cloudflare R2). Read by `npm run media`.
MEDIA_BASE_URL=
